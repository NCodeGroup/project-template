{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "Bash",
      "PowerShell"
    ],
    "ask": [
      "Bash(*.env*)",
      "PowerShell(*.env*)",
      "Bash(secrets/*)",
      "Bash(* secrets/*)",
      "Bash(* ./secrets*)",
      "Bash(* secrets)",
      "Bash(* secrets *)",
      "Bash(*\"secrets/*)",
      "Bash(*'secrets/*)",
      "Bash(*(secrets/*)",
      "Bash(*;secrets/*)",
      "Bash(*&secrets/*)",
      "Bash(*|secrets/*)",
      "Bash(*../secrets*)",
      "PowerShell(secrets/*)",
      "PowerShell(* secrets/*)",
      "PowerShell(* ./secrets*)",
      "PowerShell(* secrets)",
      "PowerShell(* secrets *)",
      "PowerShell(*\"secrets/*)",
      "PowerShell(*'secrets/*)",
      "PowerShell(*(secrets/*)",
      "PowerShell(*;secrets/*)",
      "PowerShell(*&secrets/*)",
      "PowerShell(*|secrets/*)",
      "PowerShell(*../secrets*)",
      "PowerShell(secrets\\*)",
      "PowerShell(* secrets\\*)",
      "PowerShell(* .\\secrets*)",
      "PowerShell(*\"secrets\\*)",
      "PowerShell(*'secrets\\*)",
      "PowerShell(*(secrets\\*)",
      "PowerShell(*;secrets\\*)",
      "PowerShell(*..\\secrets*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
