{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "Bash",
      "PowerShell"
    ],
    "ask": [
      "Bash(*.env*)",
      "PowerShell(*.env*)",
      "Bash(*secrets*)",
      "PowerShell(*secrets*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/secrets/**)"
    ]
  }
}
