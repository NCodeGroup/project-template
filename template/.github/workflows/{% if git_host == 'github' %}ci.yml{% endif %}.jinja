name: CI

on:
  push:
    branches: [main]
  # edited: Commit attribution reads the pull request's title and description, which a squash merge can make the commit
  # on the default branch, so it runs again when they change.
  pull_request:
    types: [opened, synchronize, reopened, edited]
  # A required check must also report in a merge queue.
  merge_group:
    types: [checks_requested]
  workflow_dispatch:

permissions:
  contents: read

# A newer push to a pull request or a topic branch, or an edit of the pull request, cancels the run it supersedes. A run
# for a default-branch commit or a merge queue entry is never cancelled: its group holds its commit SHA, because
# cancel-in-progress: false alone still lets a newer run in the same group cancel a pending one, which would leave that
# commit without a verdict.
concurrency:
{% raw %}  group: ci-${{ github.ref }}-${{ (github.ref == format('refs/heads/{0}', github.event.repository.default_branch) || github.event_name == 'merge_group') && github.sha || 'latest' }}
  cancel-in-progress: ${{ github.ref != format('refs/heads/{0}', github.event.repository.default_branch) && github.event_name != 'merge_group' }}{% endraw %}

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    defaults:
      run:
        shell: pwsh
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
{%- if stack == 'dotnet' %}
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0
        with:
          global-json-file: global.json
      # No lock file is committed, so setup-dotnet's own cache has no key: this one keys on the restore's inputs.
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.nuget/packages
{% raw %}          key: ${{ runner.os }}-nuget-${{ hashFiles('Directory.Packages.props', 'global.json', '.config/dotnet-tools.json', '**/*.csproj') }}
          restore-keys: |
            ${{ runner.os }}-nuget-{% endraw %}
{%- elif stack == 'python' %}
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.x"
      - name: Install dependencies
        if: hashFiles('**/*.py') != ''
        run: |
          # A failed install fails the step: GitHub's pwsh checks only the last command's exit code.
          $PSNativeCommandUseErrorActionPreference = $true
          python -m pip install --upgrade pip pytest
          if (Test-Path requirements.txt) { python -m pip install -r requirements.txt }
          if (Test-Path pyproject.toml) { python -m pip install -e . }
{%- elif stack == 'node' %}
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: lts/*
{%- if package_manager in ['pnpm', 'yarn'] %}
      # Corepack runs the version package.json's packageManager field names; Node.js 25 and later don't bundle it.
      - name: Enable {{ package_manager }}
        run: |
          npm install --global corepack@latest
          corepack enable {{ package_manager }}
{%- elif package_manager == 'bun' %}
      # Installs the version package.json's packageManager field names, else the latest.
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
{%- endif %}
      - name: Install dependencies
{%- if package_manager == 'pnpm' %}
        if: hashFiles('pnpm-lock.yaml') != ''
        run: pnpm install --frozen-lockfile
{%- elif package_manager == 'yarn' %}
        if: hashFiles('yarn.lock') != ''
        # Yarn 2 and later install with --immutable on CI.
        run: yarn install
{%- elif package_manager == 'bun' %}
        if: hashFiles('bun.lock', 'bun.lockb') != ''
        run: bun install --frozen-lockfile
{%- else %}
        if: hashFiles('package-lock.json') != ''
        run: npm ci
{%- endif %}
{%- elif stack == 'powershell' %}
      - name: Install modules
        if: hashFiles('**/*.ps1', '**/*.psm1') != ''
        run: Install-Module Pester, PSScriptAnalyzer -Force -Scope CurrentUser
{%- endif %}
{%- set has_code -%}
{%- if stack == 'dotnet' -%}hashFiles('**/*.csproj', '**/*.sln', '**/*.slnx') != ''
{%- elif stack == 'python' -%}hashFiles('**/*.py') != ''
{%- elif stack == 'node' -%}hashFiles('package.json') != ''
{%- elif stack == 'powershell' -%}hashFiles('**/*.ps1', '**/*.psm1') != ''
{%- endif -%}
{%- endset %}
      - name: Check the decision index
        run: ./.template/Test-AdrIndex.ps1
{%- if stack == 'dotnet' and build_command == 'dotnet build' and test_command == 'dotnet test' %}
      # The Definition of Done builds, tests and, for a library, packs, as build/dod.ps1 says.
      - name: Definition of Done
        if: {{ has_code }}
        run: ./build/dod.ps1
      # A TRX file per test project, kept after a failure too, to see which test failed.
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: test-results
          path: artifacts/test-results/
          retention-days: 14
          if-no-files-found: ignore
{%- if nuget_package %}
      # The packages a release would publish, to inspect without any publishing permission.
      - name: Upload packages
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: packages
          path: |
            artifacts/packages/*.nupkg
            artifacts/packages/*.snupkg
          retention-days: 14
          if-no-files-found: ignore
{%- endif %}
{%- else %}
{%- if build_command %}
      - name: Build
{%- if has_code %}
        if: {{ has_code }}
{%- endif %}
        run: |
          {{ build_command }}
{%- endif %}
{%- if test_command %}
      - name: Test
{%- if has_code %}
        if: {{ has_code }}
{%- endif %}
        run: |
          {{ test_command }}
{%- endif %}
{%- endif %}

  commit-attribution:
    name: Commit attribution
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Check commit attribution
        shell: pwsh
{% raw %}        env:
          BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}
          HEAD: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}
          PR_TITLE: ${{ github.event.pull_request.title }}
          PR_BODY: ${{ github.event.pull_request.body }}{% endraw %}
        run: ./.template/Test-CommitAttribution.ps1 -Base $env:BASE -Head $env:HEAD -PullRequestTitle $env:PR_TITLE -PullRequestBody $env:PR_BODY
