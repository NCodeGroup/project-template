workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
{%- if stack == 'dotnet' and nuget_package %}
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/
{%- endif %}

build-and-test:
{%- if stack == 'dotnet' %}
  image: mcr.microsoft.com/dotnet/sdk:10.0
  rules:
    - exists: ["**/*.csproj", "**/*.sln", "**/*.slnx"]
  # GitLab caches only paths inside the project folder, so NuGet keeps its packages there. The key changes with the
  # package versions and the SDK; the cache is saved again after each job, so new packages join it in between.
  variables:
    NUGET_PACKAGES: $CI_PROJECT_DIR/.nuget/packages
{%- if nuget_package %}
    # Nerdbank.GitVersioning computes the version from the history and fails on a shallow clone.
    GIT_DEPTH: "0"
{%- endif %}
  cache:
    key:
      prefix: nuget
      files: [Directory.Packages.props, global.json]
    paths: [.nuget/packages/]
  # The image supplies git and PowerShell. build/Install-Dotnet.ps1 adds to its .NET the SDK global.json selects, as
  # actions/setup-dotnet does on GitHub, and the runtimes build/Get-TestRuntimes.ps1 names, each once its download
  # matches the SHA-512 in Microsoft's release metadata, so dotnet on the PATH builds and tests with them.
  before_script:
    - pwsh -NoProfile -File build/Install-Dotnet.ps1
{%- elif stack == 'python' %}
  image: python:3
  rules:
    - exists: ["**/*.py"]
  before_script:
    - python -m pip install --upgrade pip pytest pytest-cov
    - if [ -f requirements.txt ]; then python -m pip install -r requirements.txt; fi
    - if [ -f pyproject.toml ]; then python -m pip install -e .; fi
{%- elif stack == 'node' %}
  image: {{ 'oven/bun:1' if package_manager == 'bun' else 'node:lts' }}
  rules:
    - exists: ["package.json"]
  before_script:
{%- if package_manager != 'bun' and uses_node %}
    # The Node.js .node-version names: the image's when it is that release, else selected through nvs, which
    # install-nvs.sh installs pinned to a release's commit (ADR-0200); later commands run with it on PATH.
    - . ./.template/use-node.sh 2>/dev/null || { bash ./.template/install-nvs.sh && . ./.template/use-node.sh; }
{%- endif %}
{%- if package_manager in ['pnpm', 'yarn'] %}
    # Corepack runs the version package.json's packageManager field names; Node.js 25 and later don't bundle it.
    - npm install --global corepack@latest
    - corepack enable {{ package_manager }}
{%- endif %}
{%- if package_manager == 'pnpm' %}
    - if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; fi
{%- elif package_manager == 'yarn' %}
    # Yarn 2 and later install with --immutable on CI.
    - if [ -f yarn.lock ]; then yarn install; fi
{%- elif package_manager == 'bun' %}
    - if [ -f bun.lock ] || [ -f bun.lockb ]; then bun install --frozen-lockfile; fi
{%- else %}
    - if [ -f package-lock.json ]; then npm ci; fi
{%- endif %}
{%- elif stack == 'powershell' %}
  # The .NET SDK image, which the decision-index job also runs in, supplies a supported PowerShell, Git and curl.
  image: mcr.microsoft.com/dotnet/sdk:10.0
  rules:
    - exists: ["**/*.ps1", "**/*.psm1"]
  before_script:
    - pwsh -NoProfile -Command "Install-Module Pester, PSScriptAnalyzer -Force -Scope CurrentUser"
{%- elif uses_node %}
  # node:lts, the Node.js stack's image, has the bash, Git and curl nvs needs, and the glibc the Node.js builds it
  # downloads run on.
  image: node:lts
  before_script:
{%- else %}
  image: alpine:3
{%- endif %}
{%- if uses_node and stack != 'node' %}
    # The Node.js .node-version names: the image's when it is that release, else selected through nvs, which
    # install-nvs.sh installs pinned to a release's commit (ADR-0200); later commands run with it on PATH.
    - . ./.template/use-node.sh 2>/dev/null || { bash ./.template/install-nvs.sh && . ./.template/use-node.sh; }
{%- endif %}
  script:
{%- if stack == 'node' and node_lint is defined and node_lint %}
    # Biome's formatter and linter, with the rules in biome.json (ADR-0201).
    - {{ package_manager }} run lint
{%- endif %}
{%- if stack == 'dotnet' and build_command == 'dotnet build' and test_command == 'dotnet test' %}
    # The Definition of Done builds, tests and, for a library, packs, as build/dod.ps1 says.
    - pwsh -NoProfile -File build/dod.ps1
  # A TRX file per test project, kept after a failure too, and for a library the packages a release would publish.
  artifacts:
    when: always
    paths: [artifacts/test-results/, artifacts/packages/]
    expire_in: 14 days
{%- else %}
{%- if not build_command and not test_command %}
    - echo "No build or test command configured"
{%- endif %}
{%- for command in [build_command, test_command] if command %}
    - |
      {{ ("pwsh -NoProfile -Command '" ~ command ~ "'") if stack == 'powershell' else command }}
{%- endfor %}
{%- if coverage_gate is defined and coverage_gate and stack in ['python', 'node', 'powershell'] and test_command %}
  # The coverage reports, for the coverage job.
  artifacts:
    when: always
    paths: [coverage.xml, lcov.info, coverage/]
    expire_in: 14 days
{%- endif %}
{%- endif %}
{%- if coverage_gate is defined and coverage_gate and stack in ['python', 'node', 'powershell'] and test_command %}

# Fails below 90% of the statements or 80% of the branches, from the reports build-and-test kept (ADR-0026). The .NET
# SDK image has PowerShell, which the stack's own image may lack.
coverage:
  image: mcr.microsoft.com/dotnet/sdk:10.0
  needs: [build-and-test]
  rules:
    - exists: {% if stack == 'python' %}["**/*.py"]{% elif stack == 'node' %}["package.json"]{% else %}["**/*.ps1", "**/*.psm1"]{% endif %}
  script:
    - pwsh -NoProfile -File .template/Test-Coverage.ps1
{%- endif %}
{%- if stack in ['node', 'python'] %}

# Checks the dependencies against the known vulnerabilities on every pipeline, the weekly one the template's
# tools/Set-GitLabBaseline.ps1 schedules included, and fails on one of moderate severity or above (ADR-0029).
dependency-audit:
{%- if stack == 'node' %}
  image: {{ 'oven/bun:1' if package_manager == 'bun' else 'node:lts' }}
  rules:
    - exists: [{% if package_manager == 'pnpm' %}"pnpm-lock.yaml"{% elif package_manager == 'yarn' %}"yarn.lock"{% elif package_manager == 'bun' %}"bun.lock", "bun.lockb"{% else %}"package-lock.json"{% endif %}]
{%- if package_manager in ['pnpm', 'yarn'] %}
  before_script:
    - npm install --global corepack@latest
    - corepack enable {{ package_manager }}
{%- endif %}
  script:
    - {% if package_manager == 'pnpm' %}pnpm audit --audit-level moderate{% elif package_manager == 'yarn' %}yarn npm audit --all --recursive --severity moderate{% elif package_manager == 'bun' %}bun audit --audit-level=moderate{% else %}npm audit --audit-level=moderate{% endif %}
{%- else %}
  image: python:3
  rules:
    - exists: ["requirements.txt", "pyproject.toml"]
  script:
    - python -m pip install --upgrade pip pip-audit
    - if [ -f requirements.txt ]; then pip-audit -r requirements.txt; fi
    - if [ -f pyproject.toml ]; then pip-audit .; fi
{%- endif %}
{%- endif %}
{%- if stack == 'dotnet' and nuget_package %}

# Runs when a stable version tag is pushed, after the project's own publish job when it has one. It needs a project
# access token (role Developer, scopes api and write_repository) in the protected, masked CI/CD variable
# BASELINE_TOKEN; a protected variable reaches only pipelines of protected branches and tags, so the v* tags must be
# protected for tag pipelines to read it; without the variable the job is skipped. It pushes baseline-<version> from
# the default branch's tip and opens a draft merge request that a person marks ready (ADR-0150). The .NET SDK image
# has git and PowerShell.
raise-baseline:
  image: mcr.microsoft.com/dotnet/sdk:10.0
  needs:
    - job: publish
      optional: true
  variables:
    GIT_DEPTH: "0"
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/ && $BASELINE_TOKEN
  script:
    - export VERSION="${CI_COMMIT_TAG#v}"
    - export BRANCH="baseline-$VERSION"
    - export URL="https://baseline:${BASELINE_TOKEN}@${CI_SERVER_HOST}/${CI_PROJECT_PATH}.git"
    - git ls-remote --exit-code --heads "$URL" "$BRANCH" > /dev/null && STATUS=0 || STATUS=$?
    - if [ "$STATUS" -eq 0 ]; then echo "$BRANCH exists already"; exit 0; fi
    - if [ "$STATUS" -ne 2 ]; then echo "git ls-remote failed with exit code $STATUS"; exit 1; fi
    - git config user.name "GitLab CI"
    - git config user.email "gitlab-ci@${CI_SERVER_HOST}"
    - git fetch "$URL" "$CI_DEFAULT_BRANCH"
    - git switch -c "$BRANCH" FETCH_HEAD
    - pwsh -NoProfile -File build/Update-Baseline.ps1 -Version "$VERSION"
    - if git diff --quiet; then echo "The baseline is already at $VERSION"; exit 0; fi
    - git commit -am "Raise the package validation baseline to $VERSION"
    - 'git push "$URL" "HEAD:$BRANCH" -o merge_request.create -o merge_request.target="$CI_DEFAULT_BRANCH" -o "merge_request.title=Draft: Raise the package validation baseline to $VERSION"'
{%- endif %}

# The .NET SDK image has git and PowerShell. The job checks the decision index, which every project has, code or not,
# against the merge request's base: a merge request pipeline fetches no default-branch ref. It runs on every pipeline,
# so every merge request has one.
decision-index:
  image: mcr.microsoft.com/dotnet/sdk:10.0
  variables:
    GIT_DEPTH: "0"
  script:
    - pwsh -NoProfile -File .template/Test-AdrIndex.ps1 -Base "$CI_MERGE_REQUEST_DIFF_BASE_SHA"
{%- if file_headers is defined and file_headers and stack != 'dotnet' %}

# Each source file starts with the copyright line and the SPDX license line (ADR-0027). The .NET SDK image has git and
# PowerShell.
file-headers:
  image: mcr.microsoft.com/dotnet/sdk:10.0
  script:
    - pwsh -NoProfile -File .template/Test-FileHeaders.ps1
{%- endif %}
