workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

build-and-test:
{%- if stack == 'dotnet' %}
  image: mcr.microsoft.com/dotnet/sdk:10.0
  rules:
    - exists: ["**/*.csproj", "**/*.sln", "**/*.slnx"]
  # GitLab caches only paths inside the project folder, so NuGet keeps its packages there. The key changes with the
  # package versions and the SDK; the cache is saved again after each job, so new packages join it in between.
  variables:
    NUGET_PACKAGES: $CI_PROJECT_DIR/.nuget/packages
  cache:
    key:
      prefix: nuget
      files: [Directory.Packages.props, global.json]
    paths: [.nuget/packages/]
{%- elif stack == 'python' %}
  image: python:3
  rules:
    - exists: ["**/*.py"]
  before_script:
    - python -m pip install --upgrade pip pytest
    - if [ -f requirements.txt ]; then python -m pip install -r requirements.txt; fi
    - if [ -f pyproject.toml ]; then python -m pip install -e .; fi
{%- elif stack == 'node' %}
  image: {{ 'oven/bun:1' if package_manager == 'bun' else 'node:lts' }}
  rules:
    - exists: ["package.json"]
  before_script:
{%- if package_manager in ['pnpm', 'yarn'] %}
    # Corepack runs the version package.json's packageManager field names; Node.js 25 and later don't bundle it.
    - npm install --global corepack@latest
    - corepack enable {{ package_manager }}
{%- endif %}
{%- if package_manager == 'pnpm' %}
    - if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; fi
{%- elif package_manager == 'yarn' %}
    # Yarn 2 and later install with --immutable on CI.
    - if [ -f yarn.lock ]; then yarn install; fi
{%- elif package_manager == 'bun' %}
    - if [ -f bun.lock ] || [ -f bun.lockb ]; then bun install --frozen-lockfile; fi
{%- else %}
    - if [ -f package-lock.json ]; then npm ci; fi
{%- endif %}
{%- elif stack == 'powershell' %}
  image: mcr.microsoft.com/powershell:lts
  rules:
    - exists: ["**/*.ps1", "**/*.psm1"]
  before_script:
    - pwsh -NoProfile -Command "Install-Module Pester, PSScriptAnalyzer -Force -Scope CurrentUser"
{%- else %}
  image: alpine:3
{%- endif %}
  script:
{%- if stack == 'dotnet' and build_command == 'dotnet build' and test_command == 'dotnet test' %}
    # The Definition of Done builds, tests and, for a library, packs, as build/dod.ps1 says.
    - pwsh -NoProfile -File build/dod.ps1
  # A TRX file per test project, kept after a failure too, and for a library the packages a release would publish.
  artifacts:
    when: always
    paths: [artifacts/test-results/, artifacts/packages/]
    expire_in: 14 days
{%- else %}
{%- if not build_command and not test_command %}
    - echo "No build or test command configured"
{%- endif %}
{%- for command in [build_command, test_command] if command %}
    - |
      {{ ("pwsh -NoProfile -Command '" ~ command ~ "'") if stack == 'powershell' else command }}
{%- endfor %}
{%- endif %}

# The .NET SDK image has git and PowerShell; the check needs the full history. It also checks the decision index,
# which every project has, code or not, against the merge request's base: a merge request pipeline fetches no
# default-branch ref.
# On a merge request it also reads the title and description, passed through the environment so the shell never expands them.
commit-attribution:
  image: mcr.microsoft.com/dotnet/sdk:10.0
  variables:
    GIT_DEPTH: "0"
  script:
    - |
      BASE="${CI_MERGE_REQUEST_DIFF_BASE_SHA:-$CI_COMMIT_BEFORE_SHA}" pwsh -NoProfile -Command '& ./.template/Test-CommitAttribution.ps1 -Base $env:BASE -Head $env:CI_COMMIT_SHA -PullRequestTitle $env:CI_MERGE_REQUEST_TITLE -PullRequestBody $env:CI_MERGE_REQUEST_DESCRIPTION; exit $LASTEXITCODE'
    - pwsh -NoProfile -File .template/Test-AdrIndex.ps1 -Base "$CI_MERGE_REQUEST_DIFF_BASE_SHA"
