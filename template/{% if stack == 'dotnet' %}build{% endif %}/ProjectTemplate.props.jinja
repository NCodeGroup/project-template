<Project>

  <!-- Shared build settings from the project template, imported by Directory.Build.props. Template updates replace this file; never edit it. Override a setting in Directory.Build.props, after the import. The decisions behind them are in docs/decisions/project-template/. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Roslyn reports unused usings (IDE0005) in the build only when it generates XML documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
{%- if not nuget_package %}
    <NoWarn>$(NoWarn);CS1591</NoWarn>
{%- endif %}
    <!-- A newly published NuGet advisory fails CI, but not a local build of unchanged code. -->
    <WarningsNotAsErrors Condition="'$(CI)' != 'true'">$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Minimal-API request delegates are generated at compile time; only the Web SDK reads this. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>{{ author_name }}</Authors>
    <Company>{{ author_name }}</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) {{ author_name }}</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Analyzer severities (ProjectTemplate.globalconfig; .editorconfig overrides them) and the banned APIs (BannedApiAnalyzers, referenced in Directory.Packages.props). Add a list of the project's own as BannedSymbols.<name>.txt in Directory.Build.props. -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)ProjectTemplate.globalconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
{%- if nuget_package %}

  <!-- NuGet packages: license expression, README and icon in each package, Source Link (built into the .NET SDK) with untracked sources, symbol packages and XML documentation. A project's own README.md is its package's readme; without one, the repository's is. -->
  <PropertyGroup>
    <PackageLicenseExpression>{{ package_license }}</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
{%- if package_icon %}
    <PackageIcon>{{ package_icon }}</PackageIcon>
{%- endif %}
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <!-- Include, not Update: this file is read before the SDK adds the project's files as items. -->
    <None Include="$(MSBuildProjectDirectory)/README.md" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Condition="!Exists('$(MSBuildProjectDirectory)/README.md')" Pack="true" PackagePath="/" Visible="false" />
{%- if package_icon %}
    <None Include="$(MSBuildThisFileDirectory)../{{ package_icon }}" Pack="true" PackagePath="/" Visible="false" />
{%- endif %}
  </ItemGroup>
{%- endif %}

  <!-- Test projects, named <Name>.Tests by the C# conventions. IsTestProject isn't set yet when this file is read. They keep XML documentation on, which IDE0005 needs, without requiring comments (CS1591). Their method names use underscores (CA1707), and the other rules are noise in tests; .github/instructions/csharp-tests.instructions.md says why. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1816;CA1859;CA1861;CA1869</NoWarn>
  </PropertyGroup>

</Project>
